<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>BookingName</name>
        <dataType>String</dataType>
        <expression>{!Get_Records_from_Contacts.FirstName}+&quot;_&quot;+{!Get_Rental_Houses_from_DMO.house_Id__c}</expression>
    </formulas>
    <formulas>
        <name>RentalEndDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!RentalStartDate},11)</expression>
    </formulas>
    <formulas>
        <name>RentalStartDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 15</expression>
    </formulas>
    <interviewLabel>Create House Booking Details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create House Booking Details</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This action is used create booking details</description>
        <name>House_Booking</name>
        <label>House Booking</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <inputAssignments>
            <field>City__c</field>
            <value>
                <elementReference>Get_Rental_Houses_from_DMO.City__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>House_Address__c</field>
            <value>
                <elementReference>Get_Rental_Houses_from_DMO.AddressLine__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>House_Number__c</field>
            <value>
                <elementReference>Get_Rental_Houses_from_DMO.house_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>BookingName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Frequency__c</field>
            <value>
                <stringValue>Monthly</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rental_End_Date__c</field>
            <value>
                <elementReference>RentalEndDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rental_Start_Date__c</field>
            <value>
                <elementReference>RentalStartDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tenant_Person__c</field>
            <value>
                <elementReference>Get_Records_from_Contacts.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Booking_Details__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Records_from_Contacts</name>
        <label>Get Records from Contacts</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>House_Booking</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactsEmail</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Rental_Houses_from_DMO</name>
        <label>Get Rental Houses from DMO</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Records_from_Contacts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>house_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>HouseNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pune_Available_Rental_Houses__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Rental_Houses_from_DMO</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>This field holds the Email information of a contact who is booking house</description>
        <name>ContactsEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>This holds house number which is getting booked</description>
        <name>HouseNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
